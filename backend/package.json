  "description": "Production REST API Backend for Apno Se - 40+ Social & Family Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "ts-node-dev --transpile-only src/seed/seed.ts",
    "test": "jest --runInBand --detectOpenHandles"
